NODE_ENV=development
PORT=5001
MONGODB_URI=mongodb://localhost:27017/operational_management
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# File Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# Email (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=Operational Platform <noreply@company.com>

# Certificate expiry reminders (days before)
CERT_EXPIRY_REMINDER_DAYS=30,14,7,1

# Cron schedules
CERT_STATUS_CRON=0 0 * * *
CERT_REMINDER_CRON=0 8 * * *
VEHICLE_ALERT_CRON=0 9 * * *
